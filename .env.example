# Required: Neon Postgres connection string used by the application.
DATABASE_URL=
# Integration tests are intentionally isolated from DATABASE_URL.
# Use a disposable/isolated Neon branch and opt in explicitly.
TEST_DATABASE_URL=
ALLOW_DATABASE_TESTS=false
# Neon Managed Auth URL for the active branch (obtained with `neon env pull`).
NEON_AUTH_BASE_URL=
# Generate at least 32 random characters locally; never commit the real value.
NEON_AUTH_COOKIE_SECRET=
# Canonical production origin (https, no trailing slash). Vercel must also have this domain attached and DNS configured.
NEXT_PUBLIC_SITE_URL=https://oportunia-six.vercel.app
# Keep false until DNS, legal pages, and production health are verified.
SEO_INDEXING_ENABLED=false
# Optional public contact channel. Leave empty until the real address is verified.
NEXT_PUBLIC_CONTACT_EMAIL=
# GA4 is fail-closed. Set the real G- measurement ID only after consent is configured.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# AdSense is fail-closed. Confirm readiness only after the internal review and AdSense Ready.
ADSENSE_ENABLED=false
ADSENSE_READINESS_CONFIRMED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_CATALOG_END=
ADSENSE_SLOT_DETAIL_BODY=
# Protects the scheduled ingestion endpoint from arbitrary callers.
CRON_SECRET=
# Configure concrete approved gob.pe URLs in the approved_sources table.
# Never configure a domain root or unapproved third-party sources here.
INGESTION_APPROVED_GOB_PE_URLS=
