# Copy to .env.local. CMS remains locked until all three values are configured.
EDITOR_EMAIL=editor@example.com
EDITOR_PASSWORD=
# Use at least 32 random characters, e.g. openssl rand -hex 32
SESSION_SECRET=
# Required: Neon Postgres connection string
DATABASE_URL=
# Canonical URL used by SEO metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
